{
  "name": "studio-prompter-pro",
  "version": "1.2.3",
  "description": "Studio Prompter PRO - desktop prompter for Windows and macOS",
  "main": "main.js",
  "author": "Studio Prompter",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/build-config.test.cjs",
    "build:mac": "electron-builder --mac --arm64 --publish never",
    "build:windows": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "45.3.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.studioprompter.pro",
    "productName": "StudioPrompterPro",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "icon.png",
      "icon.ico",
      "icon.icns",
      "package.json"
    ],
    "win": {
      "icon": "icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "StudioPrompterPro-${version}-win-x64.${ext}"
    },
    "portable": {
      "artifactName": "StudioPrompterPro-Portable.exe"
    },
    "mac": {
      "icon": "icon.icns",
      "category": "public.app-category.video",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false,
      "artifactName": "StudioPrompterPro-${version}-mac-arm64.${ext}"
    },
    "directories": {
      "output": "dist"
    }
  }
}
