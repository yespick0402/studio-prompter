{
  "name": "studio-prompter-pro",
  "version": "1.1.0",
  "description": "Professional Studio Prompter PRO",
  "main": "main.js",
  "author": "Studio Prompter",
  "scripts": {
    "start": "electron .",
    "dist": "node generate-icon.js && electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.studioprompter.pro",
    "productName": "StudioPrompterPro",
    "files": [
      "main.js",
      "index.html",
      "icon.png",
      "package.json"
    ],
    "win": {
      "icon": "icon.png",
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        },
        {
          "target": "zip",
          "arch": ["x64"]
        }
      ]
    },
    "portable": {
      "artifactName": "StudioPrompterPro-Portable.exe"
    },
    "mac": {
      "icon": "icon.png",
      "category": "public.app-category.video",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "zip",
          "arch": ["x64", "arm64"]
        }
      ]
    }
  }
}
